{
  "name": "kappa-bot",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "ultracite check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "fix": "ultracite fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "prepare": "lefthook install",
    "test": "bun --no-env-file test apps packages",
    "typecheck": "bun --filter @kappa/db typecheck && bun --filter @kappa/contracts typecheck && bun --filter @kappa/discord typecheck && bun --filter @kappa/service typecheck && bun --filter @kappa/web typecheck"
  },
  "dependencies": {
    "@neon/config": "^1.3.0",
    "@neon/env": "^1.2.1",
    "dotenv": "16.4.5"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.6.3",
    "drizzle-kit": "0.31.10",
    "lefthook": "2.2.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "ultracite": "8.1.0"
  },
  "engines": {
    "bun": ">=1.1"
  }
}
