{
  "name": "kappa-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "engines": {
    "bun": ">=1.1"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "start:worker": "BOT_ROLE=worker bun src/index.ts",
    "deploy:commands": "bun src/core/commands/deploy.ts",
    "deploy:pm2": "pm2 start ecosystem.config.json --only kappa-bot-gateway",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.37",
    "@neon/config": "^1.3.0",
    "@neon/env": "^1.2.1",
    "@neondatabase/serverless": "0.10.4",
    "ai": "^7.0.93",
    "cheerio": "^1.2.0",
    "cron": "^4.4.0",
    "discord.js": "^14.14.1",
    "dotenv": "16.4.5",
    "drizzle-orm": "0.45.2",
    "elysia": "^1.4.30",
    "pg": "8.11.5",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.1.6",
    "@types/pg": "8.11.6",
    "drizzle-kit": "0.31.10",
    "typescript": "5.5.4"
  }
}
