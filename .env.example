# --- Discord ---
DISCORD_TOKEN=            # bot token (from Discord Developer Portal)
CLIENT_ID=                # application id (numeric)
GUILD_ID=                 # guild id for guild-scoped (instant) command deploy

# --- Neon (two URLs; get both from Neon Console → Connect; toggle "Connection pooling") ---
DATABASE_URL=             # pooled runtime URL  (host has -pooler suffix)
DATABASE_URL_UNPOOLED=    # direct migration URL (no -pooler) — used only by drizzle-kit migrate

# --- App ---
PORT=3001                 # apps/service HTTP port (only HTTP listener; discord has none)
WEB_PORT=3000             # apps/web dashboard port (Phase 4)
LOG_LEVEL=info
BOT_ROLE=gateway          # gateway (default) | worker

# --- Service (Discord OAuth + web sessions; spec §5) ---
DISCORD_CLIENT_SECRET=    # OAuth client secret (Discord Developer Portal → OAuth2)
SERVICE_URL=              # public service origin, e.g. https://kappa.example.com (same origin as web via Caddy in prod; http://localhost:3001 for dev)
WEB_URL=                  # public web origin, e.g. https://kappa.example.com (http://localhost:3000 for dev)
SESSION_SECRET=           # random 32+ byte secret for signing OAuth state (e.g. `openssl rand -hex 32`)
DISCORD_REDIRECT_PATH=/api/v1/auth/discord/callback   # must match the redirect URI registered in the Discord portal (SERVICE_URL + this path)

# --- WAF-challenge cookies for Glints / Indeed / Jobstreet (optional) ---
# Plain fetch is challenged (Cloudflare / vendor firewall), so these adapters
# send persisted cookies harvested ONCE in a real browser — same pattern as
# ifqygazhar/jobscraper-api (cloudscraper + cookie files), minus the browser.
# How to harvest: open DevTools → Network on the site, pass the challenge,
# copy the request's full `Cookie` header value below AS-IS (one line each).
# MUST harvest with this exact UA or clearance is rejected:
#   Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36 Edg/126.0.0.0
# Clearance binds UA + IP: same-IP deployments keep cookies valid longest.
# Symptom of expiry: adapter throws HTTP 403 ("cookies may be expired") —
# re-harvest and replace the value.
# GLINTS_COOKIES=
# INDEED_COOKIES=
# JOBSTREET_COOKIES=

# --- Groq AI summaries for single-job cards (optional) ---
# GROQ_API_KEY=               # get one at console.groq.com
# GROQ_MODEL=qwen/qwen3.8-27b # override only to switch models

